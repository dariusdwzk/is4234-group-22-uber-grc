{
  "version": "v1",
  "owner": "Legal (General Counsel)",
  "programMaxCents": 1000000,
  "rules": [
    {
      "id": "R1",
      "name": "Personal data downloaded",
      "effect": "high",
      "when": [
        {
          "fact": "dataAccessed",
          "op": "isTrue"
        }
      ],
      "evidence": "{objects} objects, about {records} records",
      "unknownEvidence": "Reported by staff; scale not yet known"
    },
    {
      "id": "R2",
      "name": "Payment to an outsider on a data case",
      "effect": "high",
      "when": [
        {
          "fact": "paymentCents",
          "op": "positive"
        },
        {
          "fact": "dataAccessed",
          "op": "isTrue"
        }
      ],
      "evidence": "{payment} requested"
    },
    {
      "id": "R3",
      "name": "Payee not verified",
      "effect": "high",
      "when": [
        {
          "fact": "paymentCents",
          "op": "positive"
        },
        {
          "fact": "payeeVerified",
          "op": "isFalse"
        }
      ],
      "evidence": "Pseudonymous payee"
    },
    {
      "id": "R4",
      "name": "Payout above US$10,000 cap",
      "effect": "high",
      "when": [
        {
          "fact": "paymentCents",
          "op": "aboveCap"
        }
      ],
      "evidence": "{capMultiple}× the cap"
    },
    {
      "id": "R5",
      "name": "Payment demand from the attacker",
      "effect": "high",
      "when": [
        {
          "fact": "extortion",
          "op": "isTrue"
        }
      ],
      "evidence": "Demand for a six-figure payment"
    },
    {
      "id": "R6",
      "name": "Regulator inquiry open",
      "effect": "modifier",
      "when": [
        {
          "fact": "regulatorInquiryOpen",
          "op": "isTrue"
        },
        {
          "fact": "anyHigh",
          "op": "isTrue"
        }
      ],
      "evidence": "FTC inquiry into the 2014 breach"
    },
    {
      "id": "R8",
      "name": "Legal deadline triggered",
      "effect": "clocks",
      "when": [
        {
          "fact": "dataAccessed",
          "op": "isTrue"
        },
        {
          "fact": "jurisdictions",
          "op": "nonEmpty"
        }
      ],
      "evidence": "Residents of {jurisdictions}"
    },
    {
      "id": "R9",
      "name": "Money demanded, paid, moved or lost wrongly",
      "effect": "high",
      "when": [
        {
          "fact": "moneyConcern",
          "op": "isTrue"
        }
      ],
      "evidence": "Reported by staff"
    },
    {
      "id": "R10",
      "name": "Someone could be harmed",
      "effect": "high",
      "when": [
        {
          "fact": "harmConcern",
          "op": "isTrue"
        }
      ],
      "evidence": "Reported by staff"
    },
    {
      "id": "R11",
      "name": "Concern about how the incident is handled",
      "effect": "high",
      "when": [
        {
          "fact": "handlingConcern",
          "op": "isTrue"
        }
      ],
      "evidence": "Reported by staff; handled independently of Security"
    },
    {
      "id": "R12",
      "name": "Systems down and still happening",
      "effect": "high",
      "when": [
        {
          "fact": "systemsDown",
          "op": "isTrue"
        },
        {
          "fact": "ongoing",
          "op": "isTrue"
        }
      ],
      "evidence": "Reported by staff"
    },
    {
      "id": "R13",
      "name": "Systems down and outsiders involved",
      "effect": "high",
      "when": [
        {
          "fact": "systemsDown",
          "op": "isTrue"
        },
        {
          "fact": "outsidersAware",
          "op": "isTrue"
        }
      ],
      "evidence": "Reported by staff"
    }
  ]
}
